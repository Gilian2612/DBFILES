# =============================================
# Gestor Documental - Variables de entorno
# =============================================
# Copiar este archivo como ".env" (en la misma carpeta) y cambiar los valores.
# instalar.command lo hace solo, generando contraseñas aleatorias.
# El .env NO se sube a git (está en .gitignore).

# --- Base de datos (PostgreSQL) ---
# Usuario y nombre de la base: dejar estos valores; backup.ps1 y backup.bat los usan tal cual.
POSTGRES_USER=gestor_user
POSTGRES_DB=gestor_documental
# Contraseña de la base: cambiarla por una larga y aleatoria (ej.: openssl rand -hex 24)
POSTGRES_PASSWORD=cambiar_esta_contraseña

# --- Sesiones ---
# Clave con la que se firman los inicios de sesión. Larga y aleatoria (ej.: openssl rand -hex 32).
# Si se cambia, todos los usuarios tienen que volver a iniciar sesión.
SECRET_KEY=cambiar_esta_clave

# --- Límites (opcionales; si no se ponen, se usan estos valores) ---
# MAX_SUBIDA_MB=100              # tamaño máximo por archivo (cambiar también en frontend/index.html)
# SUBIDAS_POR_MINUTO=25          # por usuario
# LOGIN_INTENTOS_POR_MINUTO=10   # por email
